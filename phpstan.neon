includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    paths:
        - src/
        - tests/
    level: 8
    ignoreErrors:
        - identifier: larastan.noEnvCallsOutsideOfConfig
        # Pest binds $this to the TestCase class via uses(), but PHPStan sees PHPUnit\Framework\TestCase.
        # $this->app, artisan(), and loadFixture() are defined on LaravelTestCase / TestCase
        # but PHPStan cannot resolve Pest's uses() binding statically.
        - '#PHPUnit\\Framework\\TestCase::\$app#'
        - '#PHPUnit\\Framework\\TestCase::artisan\(\)#'
        - '#PHPUnit\\Framework\\TestCase::loadFixture\(\)#'
        # Same Pest uses() binding, for the Integration suite's helpers on IntegrationTestCase.
        - '#PHPUnit\\Framework\\TestCase::\$spreedly#'
        - '#PHPUnit\\Framework\\TestCase::httpStatus\(\)#'
        - '#PHPUnit\\Framework\\TestCase::assertRouteExists\(\)#'
        - '#PHPUnit\\Framework\\TestCase::sandboxToken\(\)#'
